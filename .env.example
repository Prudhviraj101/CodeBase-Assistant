# ──────────────────────────────────────────────
# Codebase Agent — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Required: Google API key for embeddings
GOOGLE_API_KEY=your_google_api_key_here

# Required: NVIDIA API key for LLM
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Optional: Override default models
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_MODEL_MINI=nvidia/nemotron-3.5-lightning-30b-a3b
USE_LOCAL_OLLAMA=False

# Optional: ChromaDB persistence directory
# CHROMA_DB_PATH=./data/chroma_db

# Optional: Cloned repos directory
# REPOS_PATH=./data/repos
